# ============================================================
# ETAPA DE ENTRENAMIENTO
# ============================================================

def run_stage(
    model,
    train_loader,
    fold_valid_loader,
    external_valid_loader,
    criterion,
    learning_rate,
    epochs,
    stage_name,
    fold,
    best_state,
    history
):

    optimizer = torch.optim.AdamW(

        filter(
            lambda parameter:
                parameter.requires_grad,
            model.parameters()
        ),

        lr=learning_rate,

        weight_decay=WEIGHT_DECAY
    )


    scheduler = (
        torch.optim.lr_scheduler.CosineAnnealingLR(
            optimizer,
            T_max=epochs
        )
    )


    scaler = torch.amp.GradScaler(

        DEVICE.type,

        enabled=(
            DEVICE.type
            ==
            "cuda"
        )
    )


    patience_counter = 0


    for epoch in range(
        1,
        epochs + 1
    ):

        start = time.time()


        train_loss, train_accuracy = (
            train_epoch(

                model,

                train_loader,

                criterion,

                optimizer,

                scaler
            )
        )


        fold_metrics = evaluate(
            model,
            fold_valid_loader
        )


        external_metrics = evaluate(
            model,
            external_valid_loader
        )


        scheduler.step()


        selection_score = (

            SHIPSNET_SELECTION_WEIGHT

            *

            fold_metrics[
                "accuracy"
            ]

            +

            EXTERNAL_SELECTION_WEIGHT

            *

            external_metrics[
                "balanced_accuracy"
            ]
        )


        seconds = (
            time.time()
            -
            start
        )


        print("\n")
        print(
            f"FOLD {fold}"
            f" | {stage_name}"
            f" | Epoch "
            f"{epoch}/{epochs}"
        )

        print(
            f"Train acc: "
            f"{train_accuracy * 100:.2f}%"
            f" | Fold val: "
            f"{fold_metrics['accuracy'] * 100:.2f}%"
            f" | External: "
            f"{external_metrics['balanced_accuracy'] * 100:.2f}%"
            f" | Score: "
            f"{selection_score * 100:.3f}%"
            f" | {seconds:.1f}s"
        )


        history.append({

            "fold":
                fold,

            "stage":
                stage_name,

            "epoch":
                epoch,

            "train_loss":
                train_loss,

            "train_accuracy":
                train_accuracy,

            "fold_accuracy":
                fold_metrics[
                    "accuracy"
                ],

            "fold_precision":
                fold_metrics[
                    "precision"
                ],

            "fold_recall":
                fold_metrics[
                    "recall"
                ],

            "fold_f1":
                fold_metrics[
                    "f1"
                ],

            "fold_balanced":
                fold_metrics[
                    "balanced_accuracy"
                ],

            "fold_auc":
                fold_metrics[
                    "roc_auc"
                ],

            "external_accuracy":
                external_metrics[
                    "accuracy"
                ],

            "external_balanced":
                external_metrics[
                    "balanced_accuracy"
                ],

            "external_auc":
                external_metrics[
                    "roc_auc"
                ],

            "selection_score":
                selection_score,

            "seconds":
                seconds,
        })


        if (
            selection_score
            >
            best_state[
                "score"
            ]
        ):

            best_state[
                "score"
            ] = selection_score

            best_state[
                "state_dict"
            ] = copy.deepcopy(
                model.state_dict()
            )

            best_state[
                "stage"
            ] = stage_name

            best_state[
                "epoch"
            ] = epoch

            best_state[
                "fold_accuracy"
            ] = fold_metrics[
                "accuracy"
            ]

            best_state[
                "external_balanced"
            ] = external_metrics[
                "balanced_accuracy"
            ]

            patience_counter = 0


        else:

            patience_counter += 1


        if (
            patience_counter
            >=
            PATIENCE
        ):

            print(
                f"Early stopping Fold {fold}"
            )

            break


    return best_state


