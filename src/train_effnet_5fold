# MAIN
# ============================================================

def main():

    set_seed(
        SEED
    )


    print(
        "=" * 90
    )

    print(
        "EFFICIENTNET-B0 - 5 FOLD STRATIFIED GROUP CROSS VALIDATION"
    )

    print(
        "=" * 90
    )


    print(
        f"\nDevice: {DEVICE}"
    )


    if DEVICE.type == "cuda":

        print(
            f"GPU: "
            f"{torch.cuda.get_device_name(0)}"
        )

        print(
            f"CUDA: "
            f"{torch.version.cuda}"
        )


    # ========================================================
    # DATOS
    # ========================================================

    shipsnet_records = (
        load_shipsnet_records()
    )


    external_train = (
        load_external_records(

            EXTERNAL_TRAIN_DIR,

            EXTERNAL_TRAIN_CSV,

            "external_train"
        )
    )


    external_valid = (
        load_external_records(

            EXTERNAL_VALID_DIR,

            EXTERNAL_VALID_CSV,

            "external_valid"
        )
    )


    labels = np.asarray([

        record["label"]

        for record
        in shipsnet_records

    ])


    groups = np.asarray([

        record["scene_id"]

        for record
        in shipsnet_records

    ])


    dummy = np.zeros(
        len(
            shipsnet_records
        )
    )


    splitter = (
        StratifiedGroupKFold(

            n_splits=N_SPLITS,

            shuffle=True,

            random_state=SEED
        )
    )


    print("\n")
    print(
        f"ShipsNet: "
        f"{len(shipsnet_records)}"
    )

    print(
        f"Scene IDs únicos: "
        f"{len(np.unique(groups))}"
    )

    print(
        f"External train: "
        f"{len(external_train)}"
    )

    print(
        f"External valid: "
        f"{len(external_valid)}"
    )


    # ========================================================
    # EXTERNAL VALID LOADER
    # ========================================================

    _, external_valid_loader = (
        create_loader(

            external_valid,

            valid_transform,

            False
        )
    )


    # ========================================================
    # RESULTADOS
    # ========================================================

    fold_results = []

    history = []

    all_oof_records = []


    # ========================================================
    # FOLDS
    # ========================================================

    for fold, (
        train_idx,
        valid_idx
    ) in enumerate(

        splitter.split(
            dummy,
            labels,
            groups
        ),

        start=1
    ):


        print("\n\n")
        print(
            "=" * 90
        )

        print(
            f"FOLD {fold}/{N_SPLITS}"
        )

        print(
            "=" * 90
        )


        # ----------------------------------------------------
        # Semilla distinta pero reproducible
        # ----------------------------------------------------

        set_seed(
            SEED
            +
            fold
        )


        # ----------------------------------------------------
        # SHIPSNET TRAIN
        # ----------------------------------------------------

        ships_train = [

            shipsnet_records[
                i
            ]

            for i
            in train_idx
        ]


        # ----------------------------------------------------
        # SHIPSNET VALID
        # ----------------------------------------------------

        ships_valid = [

            shipsnet_records[
                i
            ]

            for i
            in valid_idx
        ]


        train_scene_ids = set(

            record[
                "scene_id"
            ]

            for record
            in ships_train
        )


        valid_scene_ids = set(

            record[
                "scene_id"
            ]

            for record
            in ships_valid
        )


        overlap = (
            train_scene_ids
            &
            valid_scene_ids
        )


        if overlap:

            raise RuntimeError(
                f"Leak de scene_id en fold {fold}"
            )


        print(
            f"ShipsNet train: "
            f"{len(ships_train)}"
        )

        print(
            f"ShipsNet valid: "
            f"{len(ships_valid)}"
        )

        print(
            f"Train scenes: "
            f"{len(train_scene_ids)}"
        )

        print(
            f"Valid scenes: "
            f"{len(valid_scene_ids)}"
        )

        print(
            f"Overlap scenes: "
            f"{len(overlap)}"
        )


        # ====================================================
        # TRAIN COMBINADO
        # ====================================================

        train_records = (

            ships_train

            +

            external_train
        )


        # ====================================================
        # LOADERS
        # ====================================================

        _, train_loader = create_loader(

            train_records,

            train_transform,

            True
        )


        valid_dataset, valid_loader = (
            create_loader(

                ships_valid,

                valid_transform,

                False
            )
        )


        # ====================================================
        # CLASS WEIGHTS
        # ====================================================

        class_weights = (
            calculate_class_weights(
                train_records
            )
        )


        criterion = nn.CrossEntropyLoss(

            weight=class_weights,

            label_smoothing=LABEL_SMOOTHING
        )


        # ====================================================
        # MODELO NUEVO POR FOLD
        # ====================================================

        print(
            "\nInicializando EfficientNet-B0..."
        )


        model = create_model()

        model = model.to(
            DEVICE
        )


        best_state = {

            "score":
                -1.0,

            "state_dict":
                None,

            "stage":
                None,

            "epoch":
                None,

            "fold_accuracy":
                None,

            "external_balanced":
                None,
        }


        # ====================================================
        # ETAPA 1 - HEAD
        # ====================================================

        freeze_backbone(
            model
        )


        best_state = run_stage(

            model=model,

            train_loader=train_loader,

            fold_valid_loader=valid_loader,

            external_valid_loader=external_valid_loader,

            criterion=criterion,

            learning_rate=HEAD_LR,

            epochs=HEAD_EPOCHS,

            stage_name="HEAD",

            fold=fold,

            best_state=best_state,

            history=history
        )


        # ====================================================
        # ETAPA 2 - FINETUNE
        # ====================================================

        unfreeze_all(
            model
        )


        best_state = run_stage(

            model=model,

            train_loader=train_loader,

            fold_valid_loader=valid_loader,

            external_valid_loader=external_valid_loader,

            criterion=criterion,

            learning_rate=FINETUNE_LR,

            epochs=FINETUNE_EPOCHS,

            stage_name="FINETUNE",

            fold=fold,

            best_state=best_state,

            history=history
        )


        # ====================================================
        # CARGAR MEJOR
        # ====================================================

        model.load_state_dict(
            best_state[
                "state_dict"
            ]
        )


        model.eval()


        # ====================================================
        # GUARDAR MODELO
        # ====================================================

        fold_model_path = (

            MODELS_DIR

            /

            f"efficientnet_fold_{fold}.pt"
        )


        torch.save(

            model.state_dict(),

            fold_model_path
        )


        # ====================================================
        # EVALUACIÓN FINAL DEL FOLD
        # ====================================================

        fold_metrics = evaluate(
            model,
            valid_loader
        )


        external_metrics = evaluate(
            model,
            external_valid_loader
        )


        print_metrics(

            f"FOLD {fold} - SHIPSNET",

            fold_metrics
        )


        print_metrics(

            f"FOLD {fold} - EXTERNAL VALID",

            external_metrics
        )


        # ====================================================
        # RESULTADO FOLD
        # ====================================================

        fold_results.append({

            "fold":
                fold,

            "n_train":
                len(
                    ships_train
                ),

            "n_valid":
                len(
                    ships_valid
                ),

            "n_train_scenes":
                len(
                    train_scene_ids
                ),

            "n_valid_scenes":
                len(
                    valid_scene_ids
                ),

            "best_stage":
                best_state[
                    "stage"
                ],

            "best_epoch":
                best_state[
                    "epoch"
                ],

            "accuracy":
                fold_metrics[
                    "accuracy"
                ],

            "precision":
                fold_metrics[
                    "precision"
                ],

            "recall":
                fold_metrics[
                    "recall"
                ],

            "f1":
                fold_metrics[
                    "f1"
                ],

            "balanced_accuracy":
                fold_metrics[
                    "balanced_accuracy"
                ],

            "roc_auc":
                fold_metrics[
                    "roc_auc"
                ],

            "TN":
                fold_metrics[
                    "TN"
                ],

            "FP":
                fold_metrics[
                    "FP"
                ],

            "FN":
                fold_metrics[
                    "FN"
                ],

            "TP":
                fold_metrics[
                    "TP"
                ],

            "external_accuracy":
                external_metrics[
                    "accuracy"
                ],

            "external_balanced":
                external_metrics[
                    "balanced_accuracy"
                ],

            "external_auc":
                external_metrics[
                    "roc_auc"
                ],
        })


        # ====================================================
        # OOF
        # ====================================================

        for local_index in range(
            len(
                ships_valid
            )
        ):

            record = ships_valid[
                local_index
            ]

            all_oof_records.append({

                "fold":
                    fold,

                "filename":
                    record[
                        "filename"
                    ],

                "scene_id":
                    record[
                        "scene_id"
                    ],

                "real_label":
                    int(
                        fold_metrics[
                            "y_true"
                        ][
                            local_index
                        ]
                    ),

                "prob_ship":
                    float(
                        fold_metrics[
                            "probabilities"
                        ][
                            local_index
                        ]
                    ),

                "predicted_label":
                    int(
                        fold_metrics[
                            "y_pred"
                        ][
                            local_index
                        ]
                    ),

                "correct":
                    bool(

                        fold_metrics[
                            "y_true"
                        ][
                            local_index
                        ]

                        ==

                        fold_metrics[
                            "y_pred"
                        ][
                            local_index
                        ]
                    ),
            })


        # ====================================================
        # LIMPIAR GPU
        # ====================================================

        del model

        del train_loader

        del valid_loader

        torch.cuda.empty_cache()


    # ========================================================
    # DATAFRAMES
    # ========================================================

    folds_df = pd.DataFrame(
        fold_results
    )


    history_df = pd.DataFrame(
        history
    )


    oof_df = pd.DataFrame(
        all_oof_records
    )


    # ========================================================
    # GUARDAR
    # ========================================================

    folds_df.to_csv(

        RESULTS_DIR
        /
        "efficientnet_5fold_results.csv",

        index=False
    )


    history_df.to_csv(

        RESULTS_DIR
        /
        "efficientnet_5fold_history.csv",

        index=False
    )


    oof_df.to_csv(

        RESULTS_DIR
        /
        "efficientnet_5fold_oof_predictions.csv",

        index=False
    )


    # ========================================================
    # MÉTRICAS OOF GLOBALES
    # ========================================================

    y_true = (
        oof_df[
            "real_label"
        ]
        .to_numpy(
            dtype=np.int32
        )
    )


    y_pred = (
        oof_df[
            "predicted_label"
        ]
        .to_numpy(
            dtype=np.int32
        )
    )


    probabilities = (
        oof_df[
            "prob_ship"
        ]
        .to_numpy(
            dtype=np.float64
        )
    )


    global_accuracy = accuracy_score(
        y_true,
        y_pred
    )


    global_precision = precision_score(
        y_true,
        y_pred,
        zero_division=0
    )


    global_recall = recall_score(
        y_true,
        y_pred,
        zero_division=0
    )


    global_f1 = f1_score(
        y_true,
        y_pred,
        zero_division=0
    )


    global_balanced = (
        balanced_accuracy_score(
            y_true,
            y_pred
        )
    )


    global_auc = roc_auc_score(
        y_true,
        probabilities
    )


    global_cm = confusion_matrix(
        y_true,
        y_pred,
        labels=[
            0,
            1
        ]
    )


    # ========================================================
    # MEDIA Y STD
    # ========================================================

    mean_accuracy = (
        folds_df[
            "accuracy"
        ].mean()
    )


    std_accuracy = (
        folds_df[
            "accuracy"
        ].std(
            ddof=1
        )
    )


    mean_f1 = (
        folds_df[
            "f1"
        ].mean()
    )


    std_f1 = (
        folds_df[
            "f1"
        ].std(
            ddof=1
        )
    )


    mean_balanced = (
        folds_df[
            "balanced_accuracy"
        ].mean()
    )


    std_balanced = (
        folds_df[
            "balanced_accuracy"
        ].std(
            ddof=1
        )
    )


    # ========================================================
    # RESULTADOS
    # ========================================================

    print("\n\n")
    print(
        "=" * 100
    )

    print(
        "RESULTADO FINAL - 5 FOLD GROUP CROSS VALIDATION"
    )

    print(
        "=" * 100
    )


    for _, row in folds_df.iterrows():

        print(
            f"Fold "
            f"{int(row['fold'])}: "
            f"{row['accuracy'] * 100:.3f}%"
            f" | F1 "
            f"{row['f1'] * 100:.3f}%"
            f" | Balanced "
            f"{row['balanced_accuracy'] * 100:.3f}%"
        )


    print("\n")
    print(
        f"Accuracy media : "
        f"{mean_accuracy * 100:.3f}%"
        f" ± "
        f"{std_accuracy * 100:.3f}%"
    )


    print(
        f"F1 medio       : "
        f"{mean_f1 * 100:.3f}%"
        f" ± "
        f"{std_f1 * 100:.3f}%"
    )


    print(
        f"Balanced media : "
        f"{mean_balanced * 100:.3f}%"
        f" ± "
        f"{std_balanced * 100:.3f}%"
    )


    print("\n")
    print(
        "OOF GLOBAL"
    )

    print(
        f"Accuracy       : "
        f"{global_accuracy * 100:.3f}%"
    )

    print(
        f"Precision      : "
        f"{global_precision * 100:.3f}%"
    )

    print(
        f"Recall         : "
        f"{global_recall * 100:.3f}%"
    )

    print(
        f"F1             : "
        f"{global_f1 * 100:.3f}%"
    )

    print(
        f"Balanced Acc   : "
        f"{global_balanced * 100:.3f}%"
    )

    print(
        f"ROC-AUC        : "
        f"{global_auc:.6f}"
    )

    print(
        f"Matriz global  : "
        f"{global_cm.tolist()}"
    )


    # ========================================================
    # SUMMARY JSON
    # ========================================================

    summary = {

        "architecture":
            "EfficientNet-B0",

        "validation":
            "5-fold StratifiedGroupKFold by scene_id",

        "n_splits":
            N_SPLITS,

        "mean_accuracy":
            float(
                mean_accuracy
            ),

        "std_accuracy":
            float(
                std_accuracy
            ),

        "mean_f1":
            float(
                mean_f1
            ),

        "std_f1":
            float(
                std_f1
            ),

        "mean_balanced_accuracy":
            float(
                mean_balanced
            ),

        "std_balanced_accuracy":
            float(
                std_balanced
            ),

        "oof_global": {

            "accuracy":
                float(
                    global_accuracy
                ),

            "precision":
                float(
                    global_precision
                ),

            "recall":
                float(
                    global_recall
                ),

            "f1":
                float(
                    global_f1
                ),

            "balanced_accuracy":
                float(
                    global_balanced
                ),

            "roc_auc":
                float(
                    global_auc
                ),

            "confusion_matrix":
                global_cm.tolist(),
        },

        "folds":
            fold_results,
    }


    with open(

        RESULTS_DIR
        /
        "efficientnet_5fold_summary.json",

        "w",

        encoding="utf-8"

    ) as file:

        json.dump(
            summary,
            file,
            indent=4
        )


    print("\n")
    print(
        f"Resultados guardados en:\n"
        f"{RESULTS_DIR}"
    )


    print("\n")

    if (
        mean_accuracy
        >=
        0.99
    ):

        print(
            "✓ META ALCANZADA:"
        )

        print(
            "Accuracy media de 5 folds >= 99%"
        )

    else:

        print(
            "La media de 5 folds quedó por debajo de 99%."
        )

        print(
            "Usaremos estos resultados para decidir "
            "la siguiente optimización."
        )


    print(
        "=" * 100
    )


if __name__ == "__main__":

    main()